# JVM options for OpenLiberty server
# Copy this file to jvm.options and adapt to your environment

# Proxy settings (uncomment and adapt if behind a corporate proxy)
#-Dhttp.proxyHost=proxy.example.com
#-Dhttp.proxyPort=8080
#-Dhttps.proxyHost=proxy.example.com
#-Dhttps.proxyPort=8080
#-Dhttp.nonProxyHosts=localhost|127.0.0.1

# Reactor Netty proxy settings (used by Azure SDK)
#-Dreactor.netty.http.proxy.host=proxy.example.com
#-Dreactor.netty.http.proxy.port=8080

# Playwright driver path (optional - prefer PLAYWRIGHT_DRIVER_PATH in server.env)
#-Dplaywright.driver.path=/path/to/playwright-driver/java/driver/linux/playwright.sh
