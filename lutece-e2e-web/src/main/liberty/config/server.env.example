# Environment variables for OpenLiberty server
# Copy this file to server.env and adapt paths to your local environment

# Playwright driver path (pre-extracted from driver-bundle JAR)
# Run: cd playwright-driver && npm install
PLAYWRIGHT_DRIVER_PATH=/path/to/lutece-e2e/playwright-driver/java/driver/linux/playwright.sh
PLAYWRIGHT_NODEJS_PATH=/path/to/lutece-e2e/playwright-driver/java/driver/linux/node

# Azure OpenAI (optional - only for AI agent features)
#AZURE_OPENAI_API_KEY=your-api-key
#AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com
#AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
