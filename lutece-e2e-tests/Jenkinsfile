/**
 * Pipeline Jenkins pour les tests E2E Lutece
 *
 * Deux modes d'exécution:
 * - EXTERNAL: Tests sur une instance Lutece existante (recette, preprod, etc.)
 * - TESTCONTAINERS: Tests avec environnement Podman isolé (MariaDB + Lutece)
 *
 * Architecture:
 * - Étapes Maven: agent any (contrôleur Jenkins)
 * - Étapes Podman/Tests: agent podman
 */

pipeline {
    agent none  // Pas d'agent global, défini par stage

    environment {
        // Java / Maven
        JAVA_MAVEN = 'temurin-17-jdk'
        MAVEN = 'maven-3.9.12'
        MAVEN_OPTS = '-Dmaven.repo.local=m2-repo'
        MAVEN_USER_HOME = '.m2'  // Pour que le wrapper télécharge Maven dans le workspace

        // Playwright - image Docker avec navigateurs et dépendances pré-installés
        PLAYWRIGHT_IMAGE = 'mcr.microsoft.com/playwright/java:v1.58.0-noble'

        // Container Registry
        DOCKER_REGISTRY = '<registre>'
        DOCKER_CREDENTIALS_ID = 'NexusSTIPS_bild_user'

        // Lutece Testcontainers config
        LUTECE_CONTEXT_ROOT = '/lutece'
        LUTECE_HTTP_PORT = '9090'

        // Testcontainers avec Podman - les valeurs exactes seront détectées dynamiquement
        TESTCONTAINERS_RYUK_DISABLED = 'true'

        // Serveur Allure mutualisé - publication du rapport en fin de build.
        // Le projet est déduit du site testé par le script (un projet par site, pour que
        // les tendances d'un site ne soient pas mélangées à celles d'un autre).
        ALLURE_SERVER_URL = 'https://<serveur-allure>/allure-docker-service'
    }

    parameters {
        choice(
            name: 'TEST_MODE',
            choices: ['TESTCONTAINERS', 'EXTERNAL'],
            description: 'Mode d\'exécution: TESTCONTAINERS (Docker isolé) ou EXTERNAL (instance existante)'
        )
        string(
            name: 'LUTECE_IMAGE',
            defaultValue: '<registre>/bild/f98/site-deontologie:1.0.0-SNAPSHOT',
            description: '[TESTCONTAINERS] Image Docker Lutece à tester'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['recette', 'preprod', 'local'],
            description: '[EXTERNAL] Environnement cible'
        )
        string(
            name: 'LUTECE_URL',
            defaultValue: '',
            description: '[EXTERNAL] URL personnalisée (override ENVIRONMENT)'
        )
        string(
            name: 'SITE_ARTIFACT_ID',
            defaultValue: '',
            description: 'artifactId du site testé, identifiant du projet sur le serveur Allure. ' +
                         'Vide = lu dans le pom.properties du war embarqué dans l\'image ' +
                         '(TESTCONTAINERS) ou déduit du context root de l\'URL (EXTERNAL). ' +
                         'À renseigner en mode EXTERNAL quand le site est déployé sous un ' +
                         'context root générique type /lutece, qui ne permet pas de le déduire.'
        )
        choice(
            name: 'TEST_SUITE',
            choices: [
                'ContainerIntegrationSuite',
                'ContainerMacroIntegrationSuite',
                'WorkflowFormsIntegrationSuite',
                'MacroTestsSuite',
                'LoginContainerTest',
                'LoginTest',
                'RbacConfigurationTest',
                'WorkflowCreationTest',
                'FormsCreationTest',
                'FormsSubmissionTest',
                'AdminNavigationTest',
                'CreationQuestionTypeTextLongTest'
            ],
            description: 'Suite de tests à exécuter'
        )
        booleanParam(
            name: 'HEADLESS',
            defaultValue: true,
            description: 'Exécuter en mode headless'
        )
        booleanParam(
            name: 'SONAR_ANALYSIS',
            defaultValue: false,
            description: 'Envoyer les rapports à SonarQube'
        )
        string(
            name: 'COMMIT_AUTHOR',
            defaultValue: '',
            description: '[AUTO] Auteur du commit (transmis par la pipeline de build d\'image)'
        )
        string(
            name: 'COMMIT_EMAIL',
            defaultValue: '',
            description: '[AUTO] Email de l\'auteur du commit'
        )
        string(
            name: 'COMMIT_HASH',
            defaultValue: '',
            description: '[AUTO] Hash du commit'
        )
        string(
            name: 'PROJECT_PATH',
            defaultValue: '',
            description: '[AUTO] Chemin du projet source (ex: bild/f98/site-deontologie)'
        )
    }

    options {
        // ContainerMacroIntegrationSuite (96 tests) prend ~30 min de tests seuls,
        // auxquels s'ajoutent le build Maven et le pull des images (~5 min)
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Build & Prepare') {
            agent any  // Contrôleur Jenkins avec Maven
            stages {
                stage('Checkout') {
                    steps {
                        checkout scm
                        echo """
                        ╔══════════════════════════════════════════════════════════════╗
                        ║              LUTECE E2E TESTS - CONFIGURATION                ║
                        ╠══════════════════════════════════════════════════════════════╣
                        ║  Mode        : ${params.TEST_MODE}
                        ║  Test Suite  : ${params.TEST_SUITE}
                        ║  Headless    : ${params.HEADLESS}
                        ║  Branch      : ${env.BRANCH_NAME ?: 'N/A'}
                        ║  Commit      : ${env.GIT_COMMIT?.take(8) ?: 'N/A'}
                        ╚══════════════════════════════════════════════════════════════╝
                        """
                    }
                }

                stage('Verify Environment') {
                    steps {
                        echo '=== Vérification de l\'environnement ==='
                        withMaven(jdk: "${JAVA_MAVEN}", maven: "${MAVEN}", traceability: false) {
                            sh '''
                                echo "Java:"
                                java -version
                                echo "Maven:"
                                mvn -version
                            '''
                        }
                    }
                }

                stage('Determine Target URL') {
                    when {
                        expression { params.TEST_MODE == 'EXTERNAL' }
                    }
                    steps {
                        script {
                            if (params.LUTECE_URL?.trim()) {
                                env.TARGET_URL = params.LUTECE_URL
                            } else {
                                switch(params.ENVIRONMENT) {
                                    case 'recette':
                                        env.TARGET_URL = 'https://<site-recette>/lutece'
                                        break
                                    case 'preprod':
                                        env.TARGET_URL = 'https://<site-preprod>/site-deontologie'
                                        break
                                    case 'local':
                                    default:
                                        env.TARGET_URL = 'http://localhost:9080/lutece'
                                }
                            }
                            echo "Target URL: ${env.TARGET_URL}"
                        }
                    }
                }

                stage('Install Dependencies') {
                    steps {
                        echo '=== Installation des dépendances Maven ==='
                        withMaven(jdk: "${JAVA_MAVEN}", maven: "${MAVEN}", traceability: false) {
                            sh '''
                                # Build uniquement lutece-e2e-tests et ses dépendances (core + parent)
                                # -pl : project list, -am : also make dependencies
                                mvn clean install -DskipTests -pl lutece-e2e-tests -am -Dmaven.repo.local=${WORKSPACE}/lutece-e2e-tests/m2-repo -B -q

                                # Les commandes suivantes s'exécutent depuis le module lutece-e2e-tests
                                cd ${WORKSPACE}/lutece-e2e-tests
                                # Télécharger TOUT pour le mode offline
                                mvn dependency:go-offline -Dmaven.repo.local=m2-repo -B
                                # Forcer le téléchargement explicite des plugins de test
                                mvn surefire:help failsafe:help -Dmaven.repo.local=m2-repo -B -q
                                # Télécharger explicitement les providers JUnit Platform et leurs dépendances
                                mvn dependency:get -Dartifact=org.apache.maven.surefire:surefire-junit-platform:3.5.5 -Dtransitive=true -Dmaven.repo.local=m2-repo -B
                                mvn dependency:get -Dartifact=org.apache.maven.surefire:surefire-booter:3.5.5 -Dtransitive=true -Dmaven.repo.local=m2-repo -B
                                mvn dependency:get -Dartifact=org.apache.maven.surefire:surefire-api:3.5.5 -Dtransitive=true -Dmaven.repo.local=m2-repo -B
                                # Dépendances supplémentaires de surefire-junit-platform
                                mvn dependency:get -Dartifact=org.opentest4j:opentest4j:1.3.0 -Dmaven.repo.local=m2-repo -B
                                mvn dependency:get -Dartifact=org.junit.platform:junit-platform-launcher:1.10.2 -Dtransitive=true -Dmaven.repo.local=m2-repo -B
                                # Initialiser le Maven Wrapper
                                ./mvnw -Dmaven.repo.local=m2-repo --version
                            '''
                        }
                    }
                }

                stage('Stash Artifacts') {
                    steps {
                        echo '=== Préparation des artefacts pour l\'agent Podman ==='
                        stash includes: '**', excludes: '.git/**', name: 'workspace-stash'
                    }
                }
            }
        }

        stage('Run Tests on Podman Agent') {
            agent { label 'podman' }
            stages {
                stage('Unstash Workspace') {
                    steps {
                        unstash 'workspace-stash'
                        // Supprimer les fichiers de métadonnées qui empêchent le mode offline
                        sh '''
                            echo "=== Nettoyage des métadonnées ==="
                            find lutece-e2e-tests/m2-repo -name "_remote.repositories" -delete
                            find lutece-e2e-tests/m2-repo -name "*.lastUpdated" -delete
                        '''
                    }
                }

                stage('Verify Podman') {
                    steps {
                        echo '=== Vérification de Podman ==='
                        sh '''
                            echo "Podman:"
                            podman --version

                            # Démarrer le service socket Podman pour exposer l'API via un fichier socket
                            # Nécessaire pour monter le socket dans le conteneur Playwright
                            PODMAN_SOCKET="${XDG_RUNTIME_DIR:-/tmp/storage-run-$(id -u)}/podman/podman.sock"
                            if [ ! -S "$PODMAN_SOCKET" ]; then
                                echo "Démarrage du service socket Podman..."
                                # Tenter via systemd, sinon démarrer manuellement
                                systemctl --user start podman.socket 2>/dev/null || {
                                    mkdir -p "$(dirname $PODMAN_SOCKET)"
                                    podman system service -t 0 "unix://$PODMAN_SOCKET" &
                                    sleep 2
                                }
                            fi

                            echo "Socket Podman: $PODMAN_SOCKET"
                            ls -la "$PODMAN_SOCKET" || { echo "ERREUR: socket Podman introuvable"; exit 1; }
                        '''
                    }
                }

                stage('Podman Login') {
                    when {
                        expression { params.TEST_MODE == 'TESTCONTAINERS' }
                    }
                    steps {
                        echo '=== Connexion au registry avec Podman ==='
                        withCredentials([usernamePassword(
                            credentialsId: "${DOCKER_CREDENTIALS_ID}",
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh '''
                                echo "$DOCKER_PASS" | podman login -u "$DOCKER_USER" --password-stdin ${DOCKER_REGISTRY}
                            '''
                        }
                    }
                }

                stage('Pull Images') {
                    steps {
                        echo "=== Pull des images Docker ==="
                        // Pull de l'image Playwright (navigateurs + dépendances pré-installés)
                        sh "podman pull ${PLAYWRIGHT_IMAGE}"

                        script {
                            if (params.TEST_MODE == 'TESTCONTAINERS') {
                                echo "Pull de l'image Lutece: ${params.LUTECE_IMAGE}"

                                // Le tag est mutable (SNAPSHOT ecrase a chaque build d'image).
                                // On supprime la reference locale AVANT le pull pour forcer un
                                // telechargement reel : sinon podman peut conserver la copie locale
                                // et Testcontainers (pull policy par defaut = "utiliser le local")
                                // testerait silencieusement l'image du build precedent.
                                sh """
                                    podman rmi -f ${params.LUTECE_IMAGE} 2>/dev/null || true
                                    podman pull ${params.LUTECE_IMAGE}
                                """

                                // On fige le digest : les tests tournent sur une reference immuable,
                                // ce qui rend la version testee verifiable dans les logs et les mails.
                                env.LUTECE_IMAGE_REF = sh(
                                    returnStdout: true,
                                    script: """
                                        podman inspect --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' \
                                            ${params.LUTECE_IMAGE} 2>/dev/null || true
                                    """
                                ).trim() ?: params.LUTECE_IMAGE

                                env.LUTECE_IMAGE_CREATED = sh(
                                    returnStdout: true,
                                    script: "podman inspect --format '{{.Created}}' ${params.LUTECE_IMAGE}"
                                ).trim()

                                echo """
                                Image reellement testee : ${env.LUTECE_IMAGE_REF}
                                Date de build de l'image : ${env.LUTECE_IMAGE_CREATED}
                                """
                            }
                        }
                        sh 'echo "Images disponibles:" && podman images | head -10'
                    }
                }

                stage('Run E2E Tests - Testcontainers') {
                    when {
                        expression { params.TEST_MODE == 'TESTCONTAINERS' }
                    }
                    steps {
                        echo """
                        ╔══════════════════════════════════════════════════════════════╗
                        ║           EXÉCUTION DES TESTS TESTCONTAINERS                 ║
                        ╠══════════════════════════════════════════════════════════════╣
                        ║  Image Lutece : ${params.LUTECE_IMAGE}
                        ║  Digest       : ${env.LUTECE_IMAGE_REF ?: 'N/A'}
                        ║  Build image  : ${env.LUTECE_IMAGE_CREATED ?: 'N/A'}
                        ║  Context Root : ${LUTECE_CONTEXT_ROOT}
                        ║  Port HTTP    : ${LUTECE_HTTP_PORT}
                        ║  Test Suite   : ${params.TEST_SUITE}
                        ║  Playwright   : ${PLAYWRIGHT_IMAGE}
                        ╚══════════════════════════════════════════════════════════════╝
                        """

                        script {
                            def testClass = "fr.paris.lutece.e2e.tests.bo.testsuites.${params.TEST_SUITE}"
                            if (params.TEST_SUITE == 'WorkflowFormsIntegrationSuite') {
                                testClass = "fr.paris.lutece.e2e.tests.bo.testsuites.ContainerIntegrationSuite"
                            }
                            if (params.TEST_SUITE == 'MacroTestsSuite') {
                                testClass = "fr.paris.lutece.e2e.tests.bo.testsuites.ContainerMacroIntegrationSuite"
                            }
                            if (params.TEST_SUITE == 'LoginTest') {
                                testClass = "fr.paris.lutece.e2e.tests.bo.testsuites.LoginContainerTest"
                            }

                            // Reference immuable resolue au pull ; fallback sur le tag si indisponible
                            def luteceImageRef = env.LUTECE_IMAGE_REF?.trim() ?: params.LUTECE_IMAGE

                            sh 'mkdir -p lutece-e2e-tests/target/screenshots'

                            // Exécuter les tests dans le conteneur Playwright
                            // Le conteneur a Chromium + toutes les dépendances système pré-installées
                            sh """
                                PODMAN_SOCKET="\${XDG_RUNTIME_DIR:-/tmp/storage-run-\$(id -u)}/podman/podman.sock"
                                echo "Socket Podman: \$PODMAN_SOCKET"

                                podman run --rm \
                                    --network=host \
                                    --user root \
                                    -v \${WORKSPACE}:/work:Z \
                                    -v \$PODMAN_SOCKET:/var/run/docker.sock \
                                    -w /work/lutece-e2e-tests \
                                    -e DOCKER_HOST=unix:///var/run/docker.sock \
                                    -e TESTCONTAINERS_RYUK_DISABLED=true \
                                    -e TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock \
                                    ${PLAYWRIGHT_IMAGE} \
                                    bash -c './mvnw clean test -o \
                                        -Dmaven.repo.local=m2-repo \
                                        -Dtest=${testClass} \
                                        -Dlutece.image=${luteceImageRef} \
                                        -Dlutece.context.root=${LUTECE_CONTEXT_ROOT} \
                                        -Dlutece.http.port=${LUTECE_HTTP_PORT} \
                                        -Dtest.headless=${params.HEADLESS} \
                                        -Dtest.timeout=10000 \
                                        -B \
                                        --fail-at-end'
                            """
                        }
                    }
                    post {
                        always {
                            junit(
                                testResults: 'lutece-e2e-tests/target/surefire-reports/*.xml',
                                allowEmptyResults: true
                            )
                        }
                    }
                }

                stage('Run E2E Tests - External') {
                    when {
                        expression { params.TEST_MODE == 'EXTERNAL' }
                    }
                    steps {
                        echo """
                        ╔══════════════════════════════════════════════════════════════╗
                        ║           EXÉCUTION DES TESTS SUR INSTANCE EXTERNE           ║
                        ╠══════════════════════════════════════════════════════════════╣
                        ║  URL         : ${env.TARGET_URL}
                        ║  Test Suite  : ${params.TEST_SUITE}
                        ║  Playwright  : ${PLAYWRIGHT_IMAGE}
                        ╚══════════════════════════════════════════════════════════════╝
                        """

                        script {
                            def testClass = "fr.paris.lutece.e2e.tests.bo.testsuites.${params.TEST_SUITE}"
                            if (params.TEST_SUITE == 'ContainerIntegrationSuite') {
                                testClass = "fr.paris.lutece.e2e.tests.bo.testsuites.WorkflowFormsIntegrationSuite"
                            }
                            if (params.TEST_SUITE == 'ContainerMacroIntegrationSuite') {
                                testClass = "fr.paris.lutece.e2e.tests.bo.testsuites.MacroTestsSuite"
                            }
                            if (params.TEST_SUITE == 'LoginContainerTest') {
                                testClass = "fr.paris.lutece.e2e.tests.bo.testsuites.LoginTest"
                            }

                            sh 'mkdir -p lutece-e2e-tests/target/screenshots'

                            // Exécuter les tests dans le conteneur Playwright
                            // Propager les variables proxy pour accéder aux sites externes (HTTPS)
                            sh """
                                podman run --rm \
                                    --network=host \
                                    --user root \
                                    -v \${WORKSPACE}:/work:Z \
                                    -w /work/lutece-e2e-tests \
                                    -e http_proxy=\${http_proxy:-} \
                                    -e https_proxy=\${https_proxy:-} \
                                    -e no_proxy=\${no_proxy:-} \
                                    -e HTTP_PROXY=\${HTTP_PROXY:-} \
                                    -e HTTPS_PROXY=\${HTTPS_PROXY:-} \
                                    -e NO_PROXY=\${NO_PROXY:-} \
                                    ${PLAYWRIGHT_IMAGE} \
                                    bash -c './mvnw clean test -o \
                                        -Dmaven.repo.local=m2-repo \
                                        -Dtest=${testClass} \
                                        -Dlutece.base.url=${env.TARGET_URL} \
                                        -Dtest.headless=${params.HEADLESS} \
                                        -Dtest.timeout=30000 \
                                        -B \
                                        --fail-at-end'
                            """
                        }
                    }
                    post {
                        always {
                            junit(
                                testResults: 'lutece-e2e-tests/target/surefire-reports/*.xml',
                                allowEmptyResults: true
                            )
                        }
                    }
                }

                stage('Cleanup Podman') {
                    steps {
                        echo '=== Nettoyage Podman ==='
                        sh '''
                            podman logout ${DOCKER_REGISTRY} || true
                            podman container prune -f || true
                            podman network prune -f || true
                            podman images --filter "dangling=true" --format "{{.ID}}" | xargs -r podman rmi || echo "Aucune image dangling à supprimer."
                        '''
                    }
                }

            }
            post {
                always {
                    echo '=== Archivage des artefacts ==='
                    archiveArtifacts(
                        artifacts: 'lutece-e2e-tests/target/screenshots/**/*.png',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                    archiveArtifacts(
                        artifacts: 'lutece-e2e-tests/target/surefire-reports/**/*',
                        allowEmptyArchive: true
                    )
                    // Ni les resultats bruts ni les traces Playwright ne sont archives :
                    // tout part sur le serveur Allure (voir plus bas), qui les attache au
                    // rapport. Le script s'adapte seul a la limite de taille de la route.
                    // Le step `allure` requiert le plugin Allure Jenkins, absent de certains
                    // controleurs : sans garde, un NoSuchMethodError dans ce bloc `always`
                    // fait echouer tout le build meme quand les tests sont verts.
                    script {
                        try {
                            allure([
                                results: [[path: 'lutece-e2e-tests/target/allure-results']],
                                reportBuildPolicy: 'ALWAYS'
                            ])
                        } catch (NoSuchMethodError e) {
                            echo 'Plugin Allure Jenkins non installe : rapport non publie ici, ' +
                                 'il reste consultable sur le serveur Allure.'
                        }
                    }

                    // Publication sur le serveur Allure mutualise : resultats envoyes puis
                    // rapport genere, a chaque build. Le service ne declenche aucune
                    // generation de lui-meme. Un serveur indisponible ne doit pas faire
                    // echouer un build dont les tests sont verts.
                    echo '=== Publication du rapport sur le serveur Allure ==='
                    script {
                        // L'artifactId du site teste identifie le projet Allure : fourni par
                        // le job, sinon lu dans le pom.properties du war que l'image embarque
                        // (mode conteneur), sinon deduit du context root de l'URL cible (mode
                        // instance existante). La resolution vit dans le script, seule
                        // implementation a maintenir.
                        def siteEnv = [
                            "ALLURE_SITE_ARTIFACT_ID=${params.SITE_ARTIFACT_ID?.trim() ?: ''}",
                            params.TEST_MODE == 'TESTCONTAINERS'
                                ? "ALLURE_SITE_IMAGE=${params.LUTECE_IMAGE ?: ''}"
                                : "ALLURE_SITE_URL=${env.TARGET_URL ?: params.LUTECE_URL ?: ''}"
                        ]
                        try {
                            withEnv(siteEnv) {
                                sh 'bash lutece-e2e-tests/scripts/publish-allure.sh lutece-e2e-tests/target/allure-results'
                            }
                            // Le script y depose l'URL du rapport : le projet Allure etant
                            // resolu a l'execution, le pipeline ne peut pas la reconstruire.
                            // Mise en env pour les mails du post global, qui tourne ailleurs.
                            def urlFile = 'lutece-e2e-tests/target/allure-report-url.txt'
                            if (fileExists(urlFile)) {
                                env.ALLURE_REPORT_URL = readFile(urlFile).trim()
                                echo "Rapport Allure : ${env.ALLURE_REPORT_URL}"
                            }
                        } catch (err) {
                            echo "Publication sur le serveur Allure impossible : ${err}"
                        }
                    }
                }
            }
        }


        stage('SonarQube Analysis') {
            agent any
            when {
                expression { params.SONAR_ANALYSIS == true }
            }
            steps {
                unstash 'workspace-stash'
                echo '''
                ╔══════════════════════════════════════════════════════════════╗
                ║                 ANALYSE SONARQUBE                            ║
                ╚══════════════════════════════════════════════════════════════╝
                '''
                withSonarQubeEnv('SonarQube') {
                    withMaven(jdk: "${JAVA_MAVEN}", maven: "${MAVEN}", traceability: false) {
                        sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=lutece-e2e-tests \
                                -Dsonar.projectName='Lutece E2E Tests' \
                                -Dsonar.sources=src/test/java \
                                -Dsonar.tests=src/test/java \
                                -Dsonar.java.binaries=target/test-classes \
                                -Dsonar.junit.reportPaths=target/surefire-reports \
                                -Dsonar.qualitygate.wait=false \
                                -B
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo '''
            ╔══════════════════════════════════════════════════════════════╗
            ║                    TESTS RÉUSSIS                             ║
            ╚══════════════════════════════════════════════════════════════╝
            '''
            script {
                if (params.COMMIT_EMAIL?.trim()) {
                    emailext(
                        to: params.COMMIT_EMAIL,
                        subject: "✅ Tests E2E réussis - ${params.PROJECT_PATH ?: 'Lutece'}",
                        body: """Bonjour ${params.COMMIT_AUTHOR ?: ''},

Les tests E2E de non-régression ont réussi suite à votre push.

Projet  : ${params.PROJECT_PATH ?: 'N/A'}
Commit  : ${params.COMMIT_HASH ?: 'N/A'}
Image   : ${env.LUTECE_IMAGE_REF ?: params.LUTECE_IMAGE ?: 'N/A'}
Suite   : ${params.TEST_SUITE ?: 'N/A'}

Rapport Allure : ${env.ALLURE_REPORT_URL ?: 'non publie'}
Build Jenkins  : ${env.BUILD_URL}

Cordialement,
Jenkins CI""",
                        attachLog: false
                    )
                }
            }
        }
        failure {
            echo '''
            ╔══════════════════════════════════════════════════════════════╗
            ║                    TESTS ÉCHOUÉS                             ║
            ╚══════════════════════════════════════════════════════════════╝
            '''
            script {
                if (params.COMMIT_EMAIL?.trim()) {
                    emailext(
                        to: params.COMMIT_EMAIL,
                        subject: "❌ Tests E2E en échec - ${params.PROJECT_PATH ?: 'Lutece'}",
                        body: """Bonjour ${params.COMMIT_AUTHOR ?: ''},

Les tests E2E de non-régression ont échoué suite à votre push.

Projet  : ${params.PROJECT_PATH ?: 'N/A'}
Commit  : ${params.COMMIT_HASH ?: 'N/A'}
Image   : ${env.LUTECE_IMAGE_REF ?: params.LUTECE_IMAGE ?: 'N/A'}
Suite   : ${params.TEST_SUITE ?: 'N/A'}

Rapport Allure : ${env.ALLURE_REPORT_URL ?: 'non publie'}
Build Jenkins  : ${env.BUILD_URL}

Merci de vérifier les résultats.

Cordialement,
Jenkins CI""",
                        attachLog: true,
                        compressLog: true
                    )
                }
            }
        }
        unstable {
            echo '''
            ╔══════════════════════════════════════════════════════════════╗
            ║               TESTS INSTABLES (certains échecs)              ║
            ╚══════════════════════════════════════════════════════════════╝
            '''
            script {
                if (params.COMMIT_EMAIL?.trim()) {
                    emailext(
                        to: params.COMMIT_EMAIL,
                        subject: "⚠️ Tests E2E instables - ${params.PROJECT_PATH ?: 'Lutece'}",
                        body: """Bonjour ${params.COMMIT_AUTHOR ?: ''},

Certains tests E2E de non-régression ont échoué suite à votre push.

Projet  : ${params.PROJECT_PATH ?: 'N/A'}
Commit  : ${params.COMMIT_HASH ?: 'N/A'}
Image   : ${env.LUTECE_IMAGE_REF ?: params.LUTECE_IMAGE ?: 'N/A'}
Suite   : ${params.TEST_SUITE ?: 'N/A'}

Rapport Allure : ${env.ALLURE_REPORT_URL ?: 'non publie'}
Build Jenkins  : ${env.BUILD_URL}

Cordialement,
Jenkins CI""",
                        attachLog: false
                    )
                }
            }
        }
    }
}
